import { useState } from 'react';
import { Input } from "@/components/ui/input";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import axios from 'axios';

const samples = [
  { id: 'SCB001', organism: 'Human', tissue: 'Peripheral blood', cells: 10987 },
  { id: 'SCB002', organism: 'Human', tissue: 'Peripheral blood', cells: 12345 },
  { id: 'SCB003', organism: 'Mouse', tissue: 'Spleen', cells: 9876 },
  { id: 'SCB004', organism: 'Human', tissue: 'Tumor', cells: 15678 }
];

export default function BCRDatabase() {
  const [query, setQuery] = useState("");
  const [selectedSamples, setSelectedSamples] = useState([]);
  const [comparisonResults, setComparisonResults] = useState([]);
  const [annotationResults, setAnnotationResults] = useState([]);

  const filteredSamples = samples.filter(s =>
    s.id.includes(query) || s.organism.toLowerCase().includes(query.toLowerCase()) || s.tissue.toLowerCase().includes(query.toLowerCase())
  );

  const toggleSelect = (id) => {
    setSelectedSamples(prev =>
      prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]
    );
  };

  const handleAnnotation = async () => {
    try {
      const response = await axios.post("https://api.iedb.org/bcr_tcr_match", {
        samples: selectedSamples
      });
      setAnnotationResults(response.data.matches);
    } catch (error) {
      console.error("Annotation failed", error);
    }
  };

  const comparisonChartData = selectedSamples.map(id => {
    const sample = samples.find(s => s.id === id);
    return { name: id, cells: sample.cells };
  });

  return (
    <div className="p-6 space-y-8">
      <div className="text-3xl font-bold">Single-Cell BCR / TCR Sequencing Platform</div>
      <Card>
        <CardContent className="space-y-4 p-4">
          <p>This platform provides an integrated interface for querying, comparing, and analyzing single-cell BCR and TCR sequencing data across multiple samples. Researchers can filter by organism, tissue, or sample ID, then compare selected datasets to explore immune repertoires and identify disease-related patterns.</p>
        </CardContent>
      </Card>

      <div className="space-y-4">
        <Input
          placeholder="Search by Sample ID, Organism, or Tissue"
          value={query}
          onChange={e => setQuery(e.target.value)}
        />
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {filteredSamples.map(sample => (
            <Card key={sample.id} onClick={() => toggleSelect(sample.id)} className={`cursor-pointer ${selectedSamples.includes(sample.id) ? 'border-blue-500 border-2' : ''}`}>
              <CardContent className="p-4">
                <div className="font-semibold">{sample.id}</div>
                <div>Organism: {sample.organism}</div>
                <div>Tissue: {sample.tissue}</div>
                <div>Cells: {sample.cells.toLocaleString()}</div>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>

      {selectedSamples.length > 1 && (
        <Card>
          <CardContent className="p-4 space-y-4">
            <div className="text-xl font-bold">Comparison Results</div>
            <ResponsiveContainer width="100%" height={300}>
              <BarChart data={comparisonChartData}>
                <XAxis dataKey="name" />
                <YAxis />
                <Tooltip />
                <Bar dataKey="cells" />
              </BarChart>
            </ResponsiveContainer>
            <ul className="list-disc list-inside">
              {selectedSamples.map(id => {
                const s = samples.find(s => s.id === id);
                return <li key={id}>{id} – {s.organism}, {s.tissue}, {s.cells} cells</li>;
              })}
            </ul>
            <Button onClick={handleAnnotation}>Compare with IEDB</Button>
          </CardContent>
        </Card>
      )}

      {annotationResults.length > 0 && (
        <Card>
          <CardContent className="p-4 space-y-4">
            <div className="text-xl font-bold">IEDB Annotation Results</div>
            <ul className="list-disc list-inside">
              {annotationResults.map((result, index) => (
                <li key={index}>{result.sequence} matches known antigen: {result.antigen}</li>
              ))}
            </ul>
          </CardContent>
        </Card>
      )}
    </div>
  );
}

